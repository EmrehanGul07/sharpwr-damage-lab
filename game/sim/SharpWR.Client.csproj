<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet build of the Unity client-core package (no UnityEngine), for tests. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SharpWR.Client</AssemblyName>
    <RootNamespace>SharpWR.Client</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../packages/com.sharpwr.client/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="SharpWR.Sim.csproj" />
  </ItemGroup>
</Project>
